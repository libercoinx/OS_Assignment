{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run QEMU (gdbserver)",
      "type": "shell",
      "command": "qemu-system-riscv64",
      "args": [
        "-machine", "virt",
        "-nographic",
        "-bios", "none",
        "-kernel", "kernel.elf",
        "-S",
        "-gdb", "tcp::1234",
        "-serial", "mon:stdio"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Terminate QEMU",
      "type": "process",
      "command": "pkill",
      "args": ["-f", "qemu-system-riscv64"]
    }
  ]
}
